# Supabase — ambil dari Project Settings → API Keys
# WAJIB kunci publishable (sb_publishable_…), JANGAN kunci secret:
# variabel NEXT_PUBLIC_* disulih ke bundel browser dan terkirim ke setiap pengunjung.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Koneksi Postgres — dipakai HANYA oleh scripts/db.ts (migrasi, seed, reset),
# tidak pernah oleh aplikasi. Aplikasi bicara REST agar RLS selalu berlaku.
#
# Ambil dari Supabase Dashboard → Connect.
# Pakai host POOLER dengan port 5432 (session mode).
# JANGAN "Direct connection" (db.<ref>.supabase.co) — kini IPv6-only dan gagal
#   di jaringan IPv4; gejalanya "timeout expired", bukan error password.
# JANGAN port 6543 (transaction mode) — tidak mendukung DDL yang dipakai migrasi.
#
# Tempel password APA ADANYA. Jangan percent-encode manual — skrip yang
# melakukannya, justru supaya password ber-@ atau ber-# tidak salah terbaca.
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# Alternatif: satu URL utuh. Menang atas ketiga variabel di atas bila diisi.
# SUPABASE_DB_URL=
