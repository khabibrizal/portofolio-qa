# Supabase — ambil dari Project Settings → API Keys
# WAJIB kunci publishable (sb_publishable_…), JANGAN kunci secret:
# variabel NEXT_PUBLIC_* disulih ke bundel browser dan terkirim ke setiap pengunjung.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Koneksi Postgres — dipakai HANYA oleh scripts/db.ts (migrasi, seed, reset),
# tidak pernah oleh aplikasi. Aplikasi bicara REST agar RLS selalu berlaku.
#
# Ambil dari Supabase Dashboard → Connect → Session pooler.
# JANGAN "Direct connection" (kini IPv6-only, gagal di jaringan IPv4).
# JANGAN "Transaction pooler" (port 6543, tidak mendukung sebagian DDL migrasi).
# Password wajib percent-encoded bila memuat karakter khusus (@ → %40, # → %23).
SUPABASE_DB_URL=
